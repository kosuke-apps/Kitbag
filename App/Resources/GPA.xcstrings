{
  "sourceLanguage": "en",
  "strings": {
    "%@ credits": {
      "comment": "A credit amount, such as '3 credits'; the placeholder is a number.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 単位"
          }
        }
      }
    },
    "A course left out of the GPA, or taken pass/fail, adds nothing to it; if it is passed it still earns its credits.": {
      "comment": "Footer in the course editor.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPA から除いた科目や合否のみの科目は GPA に影響しません．合格すれば単位は修得できます．"
          }
        }
      }
    },
    "Add": {
      "comment": "Plus button label and add buttons.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追加"
          }
        }
      }
    },
    "Add a course": {
      "comment": "Menu item in a term's menu.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "科目を追加"
          }
        }
      }
    },
    "Add a course to %@…": {
      "comment": "Menu item; the placeholder is a term name.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に科目を追加…"
          }
        }
      }
    },
    "Add a grade": {
      "comment": "Button in the grade scale editor.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "成績を追加"
          }
        }
      }
    },
    "Add a grade scale": {
      "comment": "Button that adds a grade scale.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "評価方式を追加"
          }
        }
      }
    },
    "Add a term and its courses in the timetable first.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず時間割で学期と科目を追加してください．"
          }
        }
      }
    },
    "Add a term you took, or a course, with the plus button.": {
      "comment": "Hint on the GPA screen when nothing is entered.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受講した学期や科目は，＋ボタンから追加できます．"
          }
        }
      }
    },
    "Add a term…": {
      "comment": "Menu item that adds a term to the GPA tool.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学期を追加…"
          }
        }
      }
    },
    "add credits": {
      "comment": "Shown on a course that has no credits yet.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単位を入力"
          }
        }
      }
    },
    "Already safe: any grade keeps you at or above the target.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに安全: どの成績でも目標以上を保てます．"
          }
        }
      }
    },
    "Built in": {
      "comment": "Section title of the built-in grade scales.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "標準"
          }
        }
      }
    },
    "Cancel": {
      "comment": "Button.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "Code": {
      "comment": "Field name.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "科目コード"
          }
        }
      }
    },
    "Copy of %@": {
      "comment": "Menu item that starts a grade scale from a built-in one.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をコピー"
          }
        }
      }
    },
    "Count in the cumulative GPA": {
      "comment": "Switch in a term's menu.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通算 GPA に含める"
          }
        }
      }
    },
    "Counts toward the GPA": {
      "comment": "Course treatment.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPA に含める"
          }
        }
      }
    },
    "Credits": {
      "comment": "Field and column name.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単位"
          }
        }
      }
    },
    "Credits counted: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPA対象の単位: %@"
          }
        }
      }
    },
    "Credits earned: %@": {
      "comment": "Total credits earned, on the GPA screen.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修得単位: %@"
          }
        }
      }
    },
    "Credits still to earn": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残りの取得予定単位"
          }
        }
      }
    },
    "Cumulative GPA": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通算GPA"
          }
        }
      }
    },
    "Delete": {
      "comment": "Button.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        }
      }
    },
    "Delete this course": {
      "comment": "Button.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この科目を削除"
          }
        }
      }
    },
    "Delete this course?": {
      "comment": "Confirmation title.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この科目を削除しますか？"
          }
        }
      }
    },
    "Earns credit": {
      "comment": "Switch: the grade earns the credits.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "単位を修得"
          }
        }
      }
    },
    "Edit grade scales…": {
      "comment": "Menu item that opens the grade scale editor.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "成績の評価方式を編集…"
          }
        }
      }
    },
    "Edit the term…": {
      "comment": "Menu item in a term's menu.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学期を編集…"
          }
        }
      }
    },
    "Enter grades and credits to see your GPA.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "成績と単位を入力するとGPAが表示されます．"
          }
        }
      }
    },
    "Enter the credits you still have to earn.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残りの単位数を入力してください．"
          }
        }
      }
    },
    "Every course of this term has a grade.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この学期の全科目に成績があります．"
          }
        }
      }
    },
    "From scratch": {
      "comment": "Menu item that starts an empty grade scale.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初から作る"
          }
        }
      }
    },
    "GPA": {
      "comment": "Title of the GPA tool.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPA"
          }
        }
      }
    },
    "Grade": {
      "comment": "Field name.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "成績"
          }
        }
      }
    },
    "Grade of %@": {
      "comment": "Accessibility label of a grade menu; %@ is a course code.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の成績"
          }
        }
      }
    },
    "Grade scale": {
      "comment": "Screen title and menu label.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "成績の評価方式"
          }
        }
      }
    },
    "Grade scale for this term": {
      "comment": "Menu in a term's menu.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この学期の評価方式"
          }
        }
      }
    },
    "Grade scales": {
      "comment": "Screen title.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "評価方式"
          }
        }
      }
    },
    "Graded on %@": {
      "comment": "A term's note when it uses its own grade scale.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "評価方式: %@"
          }
        }
      }
    },
    "Grades, best first": {
      "comment": "Section title in the grade scale editor.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "成績（良い順）"
          }
        }
      }
    },
    "Imagine a course that is not in any term.": {
      "comment": "What-if card hint.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの学期にもない科目を仮に足してみます．"
          }
        }
      }
    },
    "Imagine grades for %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の成績を仮定します．"
          }
        }
      }
    },
    "Imagine grades for courses that have none yet.": {
      "comment": "What-if card hint.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ成績のない科目に，成績を仮に入れてみます．"
          }
        }
      }
    },
    "In the GPA": {
      "comment": "Picker label for a course's treatment.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPA での扱い"
          }
        }
      }
    },
    "It also has classes in the timetable, which go with it.": {
      "comment": "Footer when deleting a course that has classes.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間割にこの科目の授業もあり，一緒に消えます．"
          }
        }
      }
    },
    "Japan (S, A, B, C, D)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日本（S, A, B, C, D）"
          }
        }
      }
    },
    "Leave courses out": {
      "comment": "Disclosure group in the what-if card.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "科目を除いて試す"
          }
        }
      }
    },
    "Left out of the GPA": {
      "comment": "Course treatment.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPA から除く"
          }
        }
      }
    },
    "Name": {
      "comment": "Field name.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前"
          }
        }
      }
    },
    "Needs an average of %@ on those credits.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それらの単位で平均%@が必要です．"
          }
        }
      }
    },
    "New course": {
      "comment": "Title of the course editor for a new course.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい科目"
          }
        }
      }
    },
    "No courses in this term.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この学期には科目がありません．"
          }
        }
      }
    },
    "No grade": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "成績なし"
          }
        }
      }
    },
    "Not graded yet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未評価"
          }
        }
      }
    },
    "Not in the cumulative GPA": {
      "comment": "A term's note when it is left out of the cumulative GPA.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通算 GPA に含めない"
          }
        }
      }
    },
    "Now": {
      "comment": "What-if card: the GPA now.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在"
          }
        }
      }
    },
    "Out of reach: it would need more than the top grade.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "達成不可能: 最高の成績を超える必要があります．"
          }
        }
      }
    },
    "Overall": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通算"
          }
        }
      }
    },
    "Pass / fail": {
      "comment": "Course treatment.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "合否のみ"
          }
        }
      }
    },
    "Points": {
      "comment": "Field name.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポイント"
          }
        }
      }
    },
    "Points count in the GPA. A grade with no points (pass, satisfactory, incomplete) is left out of it; its switch says whether it earns the credits.": {
      "comment": "Footer in the grade scale editor.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポイントは GPA に数えられます．ポイントのない成績（合格，可，未完など）は GPA から除かれ，スイッチで単位を修得するかを決めます．"
          }
        }
      }
    },
    "Remove": {
      "comment": "Removes an imagined course.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除"
          }
        }
      }
    },
    "Same as everywhere": {
      "comment": "Choice: the term uses the grade scale chosen for the whole GPA tool.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全体の設定と同じ"
          }
        }
      }
    },
    "Save": {
      "comment": "Button.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存"
          }
        }
      }
    },
    "Start over": {
      "comment": "Clears everything imagined in the what-if card.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初からやり直す"
          }
        }
      }
    },
    "Target": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標"
          }
        }
      }
    },
    "Target GPA": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標GPA"
          }
        }
      }
    },
    "Term options": {
      "comment": "Accessibility label of a term's menu button.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学期のメニュー"
          }
        }
      }
    },
    "That is %@ or better on average.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "平均で%@以上に相当します．"
          }
        }
      }
    },
    "This term": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この学期"
          }
        }
      }
    },
    "Title": {
      "comment": "Field name.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "科目名"
          }
        }
      }
    },
    "US with plus and minus": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "米国式（プラス・マイナスあり）"
          }
        }
      }
    },
    "UW–Madison (A, AB, B…)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UW–Madison（A, AB, B…）"
          }
        }
      }
    },
    "What if": {
      "comment": "Heading of the calculator that imagines grades.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もしも"
          }
        }
      }
    },
    "Write the grades your school gives and the points each is worth. A grade with no points is not part of the GPA.": {
      "comment": "Footer under the list of the person's grade scales.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学校が付ける成績と，それぞれのポイントを書きます．ポイントのない成績は GPA に含まれません．"
          }
        }
      }
    },
    "Yours": {
      "comment": "Section title of the grade scales the person wrote.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で作ったもの"
          }
        }
      }
    }
  },
  "version": "1.0"
}
