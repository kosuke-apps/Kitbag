        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 開始"
          }
        }
      }
    },
    "%@ ends": {
      "comment": "A term's last day of classes.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 終了"
          }
        }
      }
    },
