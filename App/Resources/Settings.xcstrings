{
  "sourceLanguage": "en",
  "strings": {
    "%@ left": {
      "comment": "Time left on the signature, such as '6d 23h 41m left'.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り%@"
          }
        }
      }
    },
    "%@ starts in %lld min": {
      "comment": "Notification title before a class; the placeholders are the course code and the minutes.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は %lld 分後に始まります"
          }
        }
      }
    },
    "%lld min before": {
      "comment": "A choice of how long before a class the reminder comes.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分前"
          }
        }
      }
    },
    "%lld of %lld": {
      "comment": "How many courses get class reminders, such as '3 of 5'.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld"
          }
        }
      }
    },
    "%lld of 64": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / 64 件"
          }
        }
      }
    },
    "A build signed with a free Apple ID stops opening when this runs out, and is renewed by installing it again from the Mac.": {
      "comment": "Footer under the signature details.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料の Apple ID で署名したビルドは，これが切れると開けなくなります．Mac からもう一度インストールすると更新されます．"
          }
        }
      }
    },
    "A new deadline starts with the reminders of its kind, and you can change them for that deadline. Deadlines you import from a calendar start with them too.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい締め切りは，その種類の通知で始まります．その締め切りだけ変更することもできます．カレンダーから取り込む締め切りも同じです．"
          }
        }
      }
    },
    "A reminder that falls in these hours waits until they end, unless that would be after the thing is due.": {
      "comment": "Footer under the quiet hours switch.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時間帯のリマインダーは，終わるまで待ちます．ただし，締め切りや授業に間に合わなくなる場合は，そのまま通知します．"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "情報"
          }
        }
      }
    },
    "Account": {
      "comment": "Settings row: the developer account's name.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント"
          }
        }
      }
    },
    "All": {
      "comment": "Shown when every course gets class reminders.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて"
          }
        }
      }
    },
    "Allow notifications": {
      "comment": "Button that asks iOS for permission to show notifications.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を許可"
          }
        }
      }
    },
    "App icon": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリアイコン"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観"
          }
        }
      }
    },
    "Applies to Kitbag, its tools and the apps inside it.": {
      "comment": "Footer under the language picker.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitbag，各ツール，中で動くアプリに適用されます．"
          }
        }
      }
    },
    "Back up now": {
      "comment": "Button that makes an automatic backup now.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐバックアップ"
          }
        }
      }
    },
    "Back up to a folder…": {
      "comment": "Button that picks a folder for automatic backups.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダにバックアップ…"
          }
        }
      }
    },
    "Backup folder": {
      "comment": "Settings section title and row label.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップ用フォルダ"
          }
        }
      }
    },
    "Bento": {
      "comment": "A style: tiles of different sizes side by side.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベント"
          }
        }
      }
    },
    "Cancel": {
      "comment": "Button that dismisses a confirmation.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "Choose another folder…": {
      "comment": "Button.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のフォルダを選ぶ…"
          }
        }
      }
    },
    "Choose what to be reminded of": {
      "comment": "Link to the detailed reminder settings.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知する内容を選ぶ"
          }
        }
      }
    },
    "Classes": {
      "comment": "Section title in the reminder settings.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "授業"
          }
        }
      }
    },
    "Classic": {
      "comment": "A style: rounded cards stacked.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラシック"
          }
        }
      }
    },
    "Compact": {
      "comment": "A style: small and close together.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンパクト"
          }
        }
      }
    },
    "Connect your iPhone to your Mac and install Kitbag again to renew it.": {
      "comment": "Body of the signature warning notification.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone を Mac につないで Kitbag をもう一度インストールすると，期限が延びます．"
          }
        }
      }
    },
    "Connect your iPhone to your Mac and install Kitbag again.": {
      "comment": "Shown when the signature is about to run out.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone を Mac につないで，Kitbag をもう一度インストールしてください．"
          }
        }
      }
    },
    "Courses": {
      "comment": "Row and screen title for choosing which courses get class reminders.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "科目"
          }
        }
      }
    },
    "Dark": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダーク"
          }
        }
      }
    },
    "Data": {
      "comment": "Settings section title for backup and restore.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データ"
          }
        }
      }
    },
    "Deadline reminders and the warning before the signature runs out are local notifications: they need no internet and arrive even when Kitbag is closed.": {
      "comment": "Footer under the notification settings.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "締め切りのリマインダーと署名切れの警告はローカル通知です．ネット接続は不要で，Kitbag を閉じていても届きます．"
          }
        }
      }
    },
    "Deadlines": {
      "comment": "Section title in the reminder settings.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "締め切り"
          }
        }
      }
    },
    "Drag to reorder. Turn a part off to hide it from Today.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで並べ替えます．オフにするとTodayに表示されません．"
          }
        }
      }
    },
    "Drag to reorder. Turn a tool off to hide it from the home screen. Settings always stays.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで並べ替えます．オフにするとホーム画面に表示されません．設定は常に表示されます．"
          }
        }
      }
    },
    "Due soon": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もうすぐ期限"
          }
        }
      }
    },
    "Editorial": {
      "comment": "A style: like a printed page.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エディトリアル"
          }
        }
      }
    },
    "Every deadline can have several reminders, set when you edit it. The morning time is used for deadlines with no time of day. Reminding again repeats at that time on the mornings after the day it was due, for deadlines you have not ticked off.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "締め切りごとに複数の通知を，編集画面で設定できます．朝の通知時刻は，時刻のない締め切りに使われます．再通知は，期限の翌日からその時刻に，チェックしていない締め切りについて繰り返します．"
          }
        }
      }
    },
    "Expired": {
      "comment": "Shown instead of a time left when the signature has run out.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "期限切れ"
          }
        }
      }
    },
    "Export everything…": {
      "comment": "Button that sends a backup file of all data.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて書き出す…"
          }
        }
      }
    },
    "For %lld mornings": {
      "comment": "Remind again for this many mornings after the day a deadline was due.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 日間の朝"
          }
        }
      }
    },
    "For a deadline with no time of day, a reminder counted in hours or minutes comes on the day itself, at the morning reminder time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時刻のない締め切りでは，時間や分で数えた通知は当日の朝の通知時刻になります．"
          }
        }
      }
    },
    "Forest": {
      "comment": "A deep green theme.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォレスト"
          }
        }
      }
    },
    "From": {
      "comment": "Start of the quiet hours.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始"
          }
        }
      }
    },
    "From Headway": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Headway の通知"
          }
        }
      }
    },
    "Frosted, rounder cards that let the colours behind them show through.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すりガラスのようにぼかした，より丸いカードです．背景の色が透けて見えます．"
          }
        }
      }
    },
    "Glass": {
      "comment": "A style: frosted glass cards.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ガラス"
          }
        }
      }
    },
    "Home screen": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面"
          }
        }
      }
    },
    "How long before": {
      "comment": "Label of the lead time picker.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何分前に通知"
          }
        }
      }
    },
    "It arrives in 5 seconds. Lock the screen to see how it looks there.": {
      "comment": "Footer under the test button.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5 秒後に届きます．画面をロックすると，ロック画面での見え方を確認できます．"
          }
        }
      }
    },
    "Ivory": {
      "comment": "A warm paper theme.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイボリー"
          }
        }
      }
    },
    "Kitbag": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitbag"
          }
        }
      }
    },
    "Kitbag backup": {
      "comment": "Name of the backup file in the share sheet.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitbag バックアップ"
          }
        }
      }
    },
    "Kitbag can remind you of deadlines on this iPhone.": {
      "comment": "Body of the test notification.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone で Kitbag が締め切りをお知らせできます．"
          }
        }
      }
    },
    "Kitbag stops opening in 2 days": {
      "comment": "Notification title two days before the signature runs out.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitbag は 2 日後に開けなくなります"
          }
        }
      }
    },
    "Kitbag stops opening today at %@": {
      "comment": "Notification title on the day the signature runs out; the placeholder is a time.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitbag は今日 %@ に開けなくなります"
          }
        }
      }
    },
    "Kitbag stops opening tomorrow": {
      "comment": "Notification title the day before the signature runs out.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitbag は明日開けなくなります"
          }
        }
      }
    },
    "Kitbag's reminders": {
      "comment": "Count of reminders Kitbag has waiting on the phone.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitbag の通知"
          }
        }
      }
    },
    "Language": {
      "comment": "Settings section title and row label for the app language.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語"
          }
        }
      }
    },
    "Last backup": {
      "comment": "Settings row: when the last automatic backup was made.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後のバックアップ"
          }
        }
      }
    },
    "Light": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライト"
          }
        }
      }
    },
    "Like a printed page: sharp corners, thin rules, big serif headings and no boxes around the day.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "印刷物のような見た目です．角は直角で，細い罫線と大きな明朝系の見出しを使い，1日の予定を箱で囲みません．"
          }
        }
      }
    },
    "Made %@. It replaces the timetable, deadlines, notes and settings that are in Kitbag now. What is here now is saved first in a backup of its own, so this can be undone.": {
      "comment": "Message of the confirmation; the placeholder is the backup's date and time.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に作成．いま Kitbag にある時間割，締め切り，メモ，設定が置き換わります．いまの内容は先に別のバックアップとして保存されるので，元に戻せます．"
          }
        }
      }
    },
    "Midnight": {
      "comment": "A deep navy theme.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミッドナイト"
          }
        }
      }
    },
    "Monogram": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モノグラム"
          }
        }
      }
    },
    "Morning reminder time": {
      "comment": "Time of day at which reminders of deadlines with no time are shown.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "朝の通知時刻"
          }
        }
      }
    },
    "Mortarboard": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "角帽"
          }
        }
      }
    },
    "Never": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しない"
          }
        }
      }
    },
    "New deadlines": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい締め切り"
          }
        }
      }
    },
    "Next class": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の授業"
          }
        }
      }
    },
    "None": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なし"
          }
        }
      }
    },
    "Not set up yet": {
      "comment": "Notification permission has not been asked yet.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定"
          }
        }
      }
    },
    "Nothing is scheduled right now.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予約された通知はありません．"
          }
        }
      }
    },
    "Nothing was lost: what was in Kitbag before is kept in a backup of its own.": {
      "comment": "Alert text after a failed restore.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失われたものはありません．復元前の内容は別のバックアップとして保存されています．"
          }
        }
      }
    },
    "Notifications": {
      "comment": "Settings section title and row label for notification permission.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知"
          }
        }
      }
    },
    "Notifications are turned off for Kitbag in iOS Settings, so none of these will be shown.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS の設定で Kitbag の通知がオフのため，どれも表示されません．"
          }
        }
      }
    },
    "Notifications are working": {
      "comment": "Title of the test notification.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知は正常に動作しています"
          }
        }
      }
    },
    "Off": {
      "comment": "Notifications are not allowed.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ"
          }
        }
      }
    },
    "On": {
      "comment": "Notifications are allowed.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン"
          }
        }
      }
    },
    "One file with the timetable, deadlines, notes with their photos and files, and the settings. Send it to yourself by AirDrop or keep it in Files; opening it on another iPhone offers to restore it. Calendar subscriptions are left out because their addresses are secret.": {
      "comment": "Footer under the backup buttons.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間割，締め切り，写真やファイルを含むメモ，設定をひとつのファイルにまとめます．AirDrop で自分に送るか「ファイル」に保存してください．別の iPhone で開くと復元できます．カレンダーの購読は，アドレスが秘密のため含まれません．"
          }
        }
      }
    },
    "Open book": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いた本"
          }
        }
      }
    },
    "Open iOS Settings": {
      "comment": "Button that opens the iOS Settings app.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS の設定を開く"
          }
        }
      }
    },
    "Pencil": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "えんぴつ"
          }
        }
      }
    },
    "Pick a folder in iCloud Drive and Kitbag saves a dated backup there once a day, keeping the last ten. On another iPhone or iPad, pick the same folder and restore the newest one. This is not live sync: whichever device backed up last has the newest data.": {
      "comment": "Footer under the backup folder buttons.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive のフォルダを選ぶと，Kitbag は日付つきのバックアップを1日1回そこに保存し，直近10個を残します．別の iPhone や iPad で同じフォルダを選び，最新のバックアップを復元できます．リアルタイム同期ではなく，最後にバックアップした端末のデータが最新になります．"
          }
        }
      }
    },
    "Pinned notes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めメモ"
          }
        }
      }
    },
    "Profile": {
      "comment": "Settings row: the provisioning profile's name.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイル"
          }
        }
      }
    },
    "Quiet hours": {
      "comment": "Switch and section title.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おやすみ時間"
          }
        }
      }
    },
    "Remind again if not done": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未完了なら再通知"
          }
        }
      }
    },
    "Remind me about deadlines": {
      "comment": "Switch for deadline reminders.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "締め切りをリマインドする"
          }
        }
      }
    },
    "Remind me before classes": {
      "comment": "Switch for class reminders.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "授業の前にリマインドする"
          }
        }
      }
    },
    "Remind me before the classes of the courses that are on.": {
      "comment": "Footer on the course list for class reminders.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにした科目の授業の前にリマインドします．"
          }
        }
      }
    },
    "Reminders": {
      "comment": "Title of the reminder settings screen.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダー"
          }
        }
      }
    },
    "Reminders are made for the next week of classes each time Kitbag runs, so they stop by themselves when a term ends.": {
      "comment": "Footer under the class reminder switches.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーは Kitbag を開くたびに，向こう1週間の授業分が作られます．学期が終わると自然に止まります．"
          }
        }
      }
    },
    "Reminders cannot be shown until notifications are allowed in iOS Settings.": {
      "comment": "Footer shown when notifications are denied.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS の設定で通知を許可するまで，リマインダーは表示されません．"
          }
        }
      }
    },
    "Replace what is in Kitbag": {
      "comment": "Destructive button that restores a backup.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitbag の内容を置き換える"
          }
        }
      }
    },
    "Restore from a backup…": {
      "comment": "Button that picks a backup file to restore.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップから復元…"
          }
        }
      }
    },
    "Restore the newest backup from it": {
      "comment": "Button that restores the newest backup in the chosen folder.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新のバックアップを復元"
          }
        }
      }
    },
    "Restore this backup?": {
      "comment": "Title of the confirmation before a restore.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバックアップを復元しますか？"
          }
        }
      }
    },
    "Restored.": {
      "comment": "Alert title after a successful restore.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元しました．"
          }
        }
      }
    },
    "Rounded cards with a soft shadow, one under another.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やわらかい影の丸いカードを縦に並べます．"
          }
        }
      }
    },
    "Scheduled": {
      "comment": "Title of the list of waiting reminders.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予約済み"
          }
        }
      }
    },
    "Scheduled on this iPhone": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone に予約された通知"
          }
        }
      }
    },
    "Send a test notification": {
      "comment": "Button that sends a notification to the phone after a few seconds.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト通知を送る"
          }
        }
      }
    },
    "Settings": {
      "comment": "Title of the settings screen.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        }
      }
    },
    "Shows what iOS will actually deliver. iOS allows an app at most 64 waiting reminders, so Kitbag schedules the soonest ones and adds the rest each time it opens.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS が実際に届ける通知の一覧です．iOS は 1 つのアプリに最大 64 件までしか待機させないため，Kitbag は近いものから予約し，残りは開くたびに追加します．"
          }
        }
      }
    },
    "Signature": {
      "comment": "Settings section title.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名"
          }
        }
      }
    },
    "Signature expired %@": {
      "comment": "Footer on the home screen; the placeholder is a relative time such as '2 hours ago'.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名は%@に切れました"
          }
        }
      }
    },
    "Signature expires": {
      "comment": "Settings row: the date this build stops opening.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名の期限"
          }
        }
      }
    },
    "Signature expires %@": {
      "comment": "Footer on the home screen; the placeholder is a relative time such as 'in 6 days'.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名の期限は%@です"
          }
        }
      }
    },
    "Signed on": {
      "comment": "Settings row: when the provisioning profile was made.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名した日時"
          }
        }
      }
    },
    "Slate": {
      "comment": "A cool grey-blue theme.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スレート"
          }
        }
      }
    },
    "Small and close together, to see the whole day without scrolling.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さく詰めて並べ，スクロールせずに1日全体が見えるようにします．"
          }
        }
      }
    },
    "Stop backing up to a folder": {
      "comment": "Button.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダへのバックアップをやめる"
          }
        }
      }
    },
    "Style": {
      "comment": "Header of the choice of look (shapes and layout) apart from colours.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スタイル"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム"
          }
        }
      }
    },
    "That file could not be opened.": {
      "comment": "Alert when a picked file cannot be read.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのファイルを開けませんでした．"
          }
        }
      }
    },
    "That folder could not be used.": {
      "comment": "Shown when the chosen backup folder cannot be remembered.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのフォルダは使えません．"
          }
        }
      }
    },
    "The backup could not be made.": {
      "comment": "Alert when exporting everything fails.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを作成できませんでした．"
          }
        }
      }
    },
    "The backup could not be restored.": {
      "comment": "Alert title after a failed restore.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを復元できませんでした．"
          }
        }
      }
    },
    "The backup could not be saved: %@": {
      "comment": "Shown when writing the automatic backup fails; the placeholder is the system's reason.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップを保存できませんでした: %@"
          }
        }
      }
    },
    "The backup folder is not there any more. Choose it again.": {
      "comment": "Shown when the bookmark to the backup folder no longer resolves.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップ用のフォルダが見つかりません．選び直してください．"
          }
        }
      }
    },
    "The icon could not be changed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンを変更できませんでした．"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ"
          }
        }
      }
    },
    "There is no backup in that folder yet.": {
      "comment": "Alert when restoring the newest backup from a folder with none.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのフォルダにはまだバックアップがありません．"
          }
        }
      }
    },
    "This is not a Kitbag backup, or it is damaged.": {
      "comment": "Alert text when a file cannot be read as a backup.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitbag のバックアップではないか，ファイルが壊れています．"
          }
        }
      }
    },
    "This theme is always dark.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテーマは常にダークです．"
          }
        }
      }
    },
    "Tiles of different sizes side by side: the weather next to the next class, tools as tiles.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きさの違うタイルを並べます．天気と次の授業が横並びになり，ツールもタイルになります．"
          }
        }
      }
    },
    "Time left": {
      "comment": "Settings row: how long the signature lasts.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残り時間"
          }
        }
      }
    },
    "Today": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日"
          }
        }
      }
    },
    "Today's classes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の授業"
          }
        }
      }
    },
    "Tools": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツール"
          }
        }
      }
    },
    "Two days before, the evening before and the morning of the day Kitbag stops opening.": {
      "comment": "Footer under the signature warning switch.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitbag が開けなくなる2日前，前日の夜，当日の朝に通知します．"
          }
        }
      }
    },
    "Until": {
      "comment": "End of the quiet hours.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了"
          }
        }
      }
    },
    "Use Kitbag's suggestion": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitbag の初期設定に戻す"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン"
          }
        }
      }
    },
    "Warn before the signature runs out": {
      "comment": "Switch for the signature warnings.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名が切れる前に警告する"
          }
        }
      }
    },
    "Weather": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気"
          }
        }
      }
    },
    "What new deadlines start with": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい締め切りの初期設定"
          }
        }
      }
    }
  },
  "version": "1.0"
}
