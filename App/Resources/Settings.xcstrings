{
  "sourceLanguage": "en",
  "strings": {
    "About": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "情報"
          }
        }
      }
    },
    "Allow notifications": {
      "comment": "Button that asks iOS for permission to show notifications.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知を許可"
          }
        }
      }
    },
    "App icon": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリアイコン"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外観"
          }
        }
      }
    },
    "Connect your iPhone to your Mac and install Kitbag again to renew it.": {
      "comment": "Body of the signature warning notification.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone を Mac につないで Kitbag をもう一度インストールすると，期限が延びます．"
          }
        }
      }
    },
    "Connect your iPhone to your Mac and install Kitbag again.": {
      "comment": "Shown when the signature is about to run out.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone を Mac につないで，Kitbag をもう一度インストールしてください．"
          }
        }
      }
    },
    "Dark": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダーク"
          }
        }
      }
    },
    "Deadline reminders and the warning before the signature runs out are local notifications: they need no internet and arrive even when Kitbag is closed.": {
      "comment": "Footer under the notification settings.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "締め切りのリマインダーと署名切れの警告はローカル通知です．ネット接続は不要で，Kitbag を閉じていても届きます．"
          }
        }
      }
    },
    "Drag to reorder. Turn a part off to hide it from Today.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで並べ替えます．オフにするとTodayに表示されません．"
          }
        }
      }
    },
    "Drag to reorder. Turn a tool off to hide it from the home screen. Settings always stays.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドラッグで並べ替えます．オフにするとホーム画面に表示されません．設定は常に表示されます．"
          }
        }
      }
    },
    "Due soon": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もうすぐ期限"
          }
        }
      }
    },
    "Forest": {
      "comment": "A deep green theme.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォレスト"
          }
        }
      }
    },
    "Home screen": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面"
          }
        }
      }
    },
    "It arrives in 5 seconds. Lock the screen to see how it looks there.": {
      "comment": "Footer under the test button.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5 秒後に届きます．画面をロックすると，ロック画面での見え方を確認できます．"
          }
        }
      }
    },
    "Ivory": {
      "comment": "A warm paper theme.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイボリー"
          }
        }
      }
    },
    "Kitbag": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitbag"
          }
        }
      }
    },
    "Kitbag can remind you of deadlines on this iPhone.": {
      "comment": "Body of the test notification.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone で Kitbag が締め切りをお知らせできます．"
          }
        }
      }
    },
    "Kitbag stops opening in 2 days": {
      "comment": "Notification title two days before the signature runs out.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitbag は 2 日後に開けなくなります"
          }
        }
      }
    },
    "Kitbag stops opening today at %@": {
      "comment": "Notification title on the day the signature runs out; the placeholder is a time.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitbag は今日 %@ に開けなくなります"
          }
        }
      }
    },
    "Kitbag stops opening tomorrow": {
      "comment": "Notification title the day before the signature runs out.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitbag は明日開けなくなります"
          }
        }
      }
    },
    "Light": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライト"
          }
        }
      }
    },
    "Midnight": {
      "comment": "A deep navy theme.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ミッドナイト"
          }
        }
      }
    },
    "Monogram": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モノグラム"
          }
        }
      }
    },
    "Mortarboard": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "角帽"
          }
        }
      }
    },
    "Next class": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の授業"
          }
        }
      }
    },
    "Not set up yet": {
      "comment": "Notification permission has not been asked yet.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定"
          }
        }
      }
    },
    "Notifications": {
      "comment": "Settings section title and row label for notification permission.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知"
          }
        }
      }
    },
    "Notifications are working": {
      "comment": "Title of the test notification.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知は正常に動作しています"
          }
        }
      }
    },
    "Off": {
      "comment": "Notifications are not allowed.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフ"
          }
        }
      }
    },
    "On": {
      "comment": "Notifications are allowed.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン"
          }
        }
      }
    },
    "Open book": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いた本"
          }
        }
      }
    },
    "Open iOS Settings": {
      "comment": "Button that opens the iOS Settings app.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS の設定を開く"
          }
        }
      }
    },
    "Pencil": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "えんぴつ"
          }
        }
      }
    },
    "Pinned notes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピン留めメモ"
          }
        }
      }
    },
    "Reminders cannot be shown until notifications are allowed in iOS Settings.": {
      "comment": "Footer shown when notifications are denied.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS の設定で通知を許可するまで，リマインダーは表示されません．"
          }
        }
      }
    },
    "Send a test notification": {
      "comment": "Button that sends a notification to the phone after a few seconds.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト通知を送る"
          }
        }
      }
    },
    "Settings": {
      "comment": "Title of the settings screen.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        }
      }
    },
    "Signature expired %@": {
      "comment": "Footer on the home screen; the placeholder is a relative time such as '2 hours ago'.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名は%@に切れました"
          }
        }
      }
    },
    "Signature expires": {
      "comment": "Settings row: the date this build stops opening.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名の期限"
          }
        }
      }
    },
    "Signature expires %@": {
      "comment": "Footer on the home screen; the placeholder is a relative time such as 'in 6 days'.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名は%@に切れます"
          }
        }
      }
    },
    "Slate": {
      "comment": "A cool grey-blue theme.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スレート"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム"
          }
        }
      }
    },
    "The icon could not be changed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイコンを変更できませんでした．"
          }
        }
      }
    },
    "Theme": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テーマ"
          }
        }
      }
    },
    "This theme is always dark.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このテーマは常にダークです．"
          }
        }
      }
    },
    "Today": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日"
          }
        }
      }
    },
    "Today's classes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の授業"
          }
        }
      }
    },
    "Tools": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツール"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン"
          }
        }
      }
    },
    "Weather": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天気"
          }
        }
      }
    }
  },
  "version": "1.0"
}
