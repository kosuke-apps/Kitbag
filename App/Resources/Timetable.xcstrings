{
  "sourceLanguage": "en",
  "strings": {
    "%@ cr": {
      "comment": "Credits of a course, as in '3 cr'.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@単位"
          }
        }
      }
    },
    "%@ Timetable": {
      "comment": "The heading of a printed timetable; %@ is a term such as '2026 Fall'.",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の時間割"
          }
        }
      }
    },
