    "The class that is on now or comes next, the rest of today, and the whole week as a timetable.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いま進行中または次の授業，今日の残りの授業，そして1週間の時間割．"
          }
        }
      }
    },
    "What is due next: assignments, quizzes and exams. Tap a circle to mark one done.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に迫る課題，小テスト，試験．丸をタップすると完了にできます．"
          }
        }
      }
    },
